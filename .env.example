# PostgreSQL connection string (required)
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/frontdesk

# Enable SSL for PostgreSQL connections: 1 = enabled (rejectUnauthorized: false), 0 or unset = disabled
# Required for hosted databases like Render or Railway
PGSSL=0

# HTTP server port (defaults to 3000 if unset)
PORT=3000

# Password for agent login (defaults to 'frontdesk' if unset)
AGENT_PASSWORD=frontdesk

# Seed sample tickets and agents on startup if database is empty: 1 = enabled, 0 = disabled
SEED_SAMPLE=1
